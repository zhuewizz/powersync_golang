# 统一换行：仓库内一律 LF，避免 Windows 上反复刷 CRLF 警告
* text=auto eol=lf

# 这些脚本必须是 CRLF，否则 PowerShell 5.1 / cmd 会有兼容问题
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制（不要做换行转换）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.db   binary
*.exe  binary
*.syso binary
*.ttf  binary
